               <rdf:li>NAKAYAMA, Minoru, c/o EAMEX CORPORATION</rdf:li>
               <rdf:li>SUGIYAMA, Minoru, c/o EAMEX CORPORATION</rdf:li>
               <rdf:li>KATO, Kenji, c/o EAMEX CORPORATION</rdf:li>
               <rdf:li>ONISHI, Kazuo, c/o EAMEX CORPORATION</rdf:li>
               <rdf:li>SEWA, Shingo, c/o EAMEX CORPORATION</rdf:li>
