{
    "family": "patent-thesis",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::183631346567:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::183631346567:role/ecsTaskRole",
    "containerDefinitions": [
      {
        "name": "backend",
        "image": "183631346567.dkr.ecr.eu-north-1.amazonaws.com/patent_thesis/backend:latest",
        "essential": true,
        "portMappings": [
          { "containerPort": 5000, "protocol": "tcp" }
        ],
        "environment": [
          { "name": "API_HOST", "value": "0.0.0.0" },
          { "name": "API_PORT", "value": "5000" }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/patent-thesis",
            "awslogs-region": "eu-north-1",
            "awslogs-stream-prefix": "backend"
          }
        }
      },
      {
        "name": "frontend",
        "image": "183631346567.dkr.ecr.eu-north-1.amazonaws.com/patent_thesis/frontend:latest",
        "essential": true,
        "portMappings": [
          { "containerPort": 3000, "protocol": "tcp" }
        ],
        "environment": [
          { "name": "PORT", "value": "3000" },
          { "name": "BACKEND_URL", "value": "http://localhost:5000" }
        ],
        "dependsOn": [
          { "containerName": "backend", "condition": "START" }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/patent-thesis",
            "awslogs-region": "eu-north-1",
            "awslogs-stream-prefix": "frontend"
          }
        }
      }
    ]
  }